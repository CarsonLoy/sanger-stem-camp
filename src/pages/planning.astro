---
import { Content, getHeadings } from "../../content/planning.md";
import ActivityLayout from "../layouts/ActivityLayout.astro";

const headings = getHeadings();
const title =
  headings.find((heading) => heading.depth === 1)?.text ?? "Planning Your Camp";
---

<ActivityLayout {title} {headings} showNavigation={false}>
  <Content />
</ActivityLayout>
