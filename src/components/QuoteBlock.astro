---
interface Props {
  quote: string;
  attribution?: string;
  role?: string;
}

const { quote, attribution, role } = Astro.props;
---

<figure class="quote-block">
  <span class="mark" aria-hidden="true">“</span>
  <blockquote><p>{quote}</p></blockquote>
  {
    attribution && (
      <figcaption>
        <strong>{attribution}</strong>
        {role && <span>{role}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .quote-block {
    position: relative;
    padding: clamp(var(--space-8), 6vw, var(--space-12));
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-navy-deep);
    color: var(--color-white);
  }

  .mark {
    position: absolute;
    top: -0.65rem;
    right: var(--space-6);
    color: rgb(255 255 255 / 11%);
    font-family: var(--font-display);
    font-size: 10rem;
    line-height: 1;
  }

  blockquote {
    position: relative;
  }

  blockquote p {
    max-width: 35ch;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
  }

  figcaption {
    position: relative;
    display: flex;
    margin-top: var(--space-6);
    flex-direction: column;
    color: #b9c9da;
    font-size: var(--text-sm);
  }

  figcaption strong {
    color: var(--color-white);
  }
</style>
