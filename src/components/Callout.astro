---
interface Props {
  title: string;
  variant?: "info" | "tip" | "warning" | "why";
  label?: string;
}

const { title, variant = "info", label } = Astro.props;
const defaults = {
  info: "Good to know",
  tip: "Teacher tip",
  warning: "Watch for",
  why: "Why this matters",
};
const symbols = { info: "i", tip: "★", warning: "!", why: "?" };
---

<aside class:list={["callout", `callout--${variant}`]}>
  <span class="symbol" aria-hidden="true">{symbols[variant]}</span>
  <div>
    <p class="label">{label ?? defaults[variant]}</p>
    <h3>{title}</h3>
    <div class="body"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    --accent: var(--color-teal);
    --wash: var(--color-teal-soft);

    display: grid;
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--color-border));
    border-left: 0.35rem solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--wash);
    gap: var(--space-4);
    grid-template-columns: 2.2rem 1fr;
  }

  .callout--warning {
    --accent: var(--color-coral);
    --wash: var(--color-coral-soft);
  }

  .callout--tip {
    --accent: #a76d00;
    --wash: var(--color-gold-soft);
  }

  .callout--why {
    --accent: var(--color-navy);
    --wash: var(--color-blue-soft);
  }

  .symbol {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 900;
    line-height: 1;
    place-items: center;
  }

  .label {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 850;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h3 {
    margin-top: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }

  .body {
    margin-top: var(--space-2);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .body :global(p + p),
  .body :global(p + ul),
  .body :global(ul + p) {
    margin-top: var(--space-3);
  }

  @media (width <= 32rem) {
    .callout {
      padding: var(--space-5);
      grid-template-columns: 1fr;
    }
  }
</style>
