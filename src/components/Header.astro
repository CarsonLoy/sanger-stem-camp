---
export interface NavItem {
  label: string;
  href: string;
}

interface Props {
  siteName?: string;
  homeHref?: string;
  items?: NavItem[];
  currentPath?: string;
}

const {
  siteName = "Sanger STEM Camp",
  homeHref = "/",
  items = [],
  currentPath = "",
} = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={homeHref} aria-label={`${siteName} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" role="img">
          <path d="M10 29 20 8l10 21H10Z"></path>
          <circle cx="20" cy="22" r="4"></circle>
        </svg>
      </span>
      <span>{siteName}</span>
    </a>

    {
      items.length > 0 && (
        <nav aria-label="Primary navigation">
          <ul>
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 78%, transparent);
    background: color-mix(in srgb, var(--color-paper) 94%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    width: min(100% - 2rem, var(--wide-width));
    min-height: 4.75rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-navy-deep);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.1;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-white);
    place-items: center;
  }

  .brand-mark svg {
    width: 1.7rem;
    fill: none;
    stroke: currentcolor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }

  nav ul {
    display: flex;
    padding: 0;
    margin: 0;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  nav a {
    display: inline-flex;
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    background: var(--color-teal-soft);
    color: var(--color-teal-dark);
  }

  @media (width <= 48rem) {
    .header-inner {
      flex-wrap: wrap;
      padding-block: var(--space-3);
    }

    nav {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    nav ul {
      width: max-content;
    }
  }
</style>
