---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  label?: string;
  columns?: 2 | 3;
}

const { images, label = "Photo gallery", columns = 2 } = Astro.props;
---

<div
  class:list={["gallery", `gallery--${columns}`]}
  role="list"
  aria-label={label}
>
  {
    images.map((image) => (
      <figure role="listitem">
        <div class="image-wrap">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[360, 640, 900]}
            sizes={
              columns === 3
                ? "(max-width: 42rem) 100vw, 33vw"
                : "(max-width: 42rem) 100vw, 50vw"
            }
            loading="lazy"
            format="webp"
          />
        </div>
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gallery--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  .image-wrap {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: var(--color-surface-soft);
    box-shadow: var(--shadow-sm);
  }

  .image-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  figure:hover :global(img) {
    transform: scale(1.025);
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  @media (width <= 48rem) {
    .gallery--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width <= 34rem) {
    .gallery,
    .gallery--3 {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-wrap :global(img) {
      transition: none;
    }
  }
</style>
