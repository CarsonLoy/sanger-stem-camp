---
interface Props {
  time: string;
  title?: string;
  note?: string;
}

const { time, title = "Estimated prep time", note } = Astro.props;
---

<aside class="prep-card">
  <span class="clock" aria-hidden="true">
    <svg viewBox="0 0 24 24"
      ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg
    >
  </span>
  <div>
    <p>{title}</p>
    <strong>{time}</strong>
    {note && <span>{note}</span>}
  </div>
</aside>

<style>
  .prep-card {
    display: flex;
    padding: var(--space-5);
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    gap: var(--space-4);
  }

  .clock {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-gold-soft);
    color: #8a5b00;
    place-items: center;
  }

  svg {
    width: 1.45rem;
    fill: none;
    stroke: currentcolor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  p {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  strong {
    display: block;
    color: var(--color-navy-deep);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  span:not(.clock) {
    display: block;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }
</style>
