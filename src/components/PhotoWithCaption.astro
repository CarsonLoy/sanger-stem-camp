---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  aspectRatio?: "landscape" | "portrait" | "square" | "natural";
  eager?: boolean;
}

const {
  src,
  alt,
  caption,
  credit,
  aspectRatio = "natural",
  eager = false,
} = Astro.props;
---

<figure>
  <div class:list={["image-wrap", `image-wrap--${aspectRatio}`]}>
    <Image
      {src}
      {alt}
      widths={[480, 768, 1100, 1440]}
      sizes="(max-width: 52rem) calc(100vw - 2rem), 47rem"
      loading={eager ? "eager" : "lazy"}
      format="webp"
    />
  </div>
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span>{caption}</span>}
        {credit && <span class="credit">Photo: {credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  figure {
    margin: 0;
  }

  .image-wrap {
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-surface-soft);
    box-shadow: var(--shadow-sm);
  }

  .image-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-wrap--landscape {
    aspect-ratio: 16 / 10;
  }

  .image-wrap--portrait {
    aspect-ratio: 4 / 5;
  }

  .image-wrap--square {
    aspect-ratio: 1;
  }

  .image-wrap--natural :global(img) {
    height: auto;
  }

  figcaption {
    display: flex;
    margin-top: var(--space-3);
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .credit {
    flex: none;
    font-style: italic;
  }

  @media (width <= 32rem) {
    figcaption {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
