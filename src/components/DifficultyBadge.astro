---
interface Props {
  level: "Beginner" | "Intermediate" | "Advanced";
  label?: string;
}

const { level, label = "Difficulty" } = Astro.props;
const filled = level === "Beginner" ? 1 : level === "Intermediate" ? 2 : 3;
---

<span
  class:list={["badge", `badge--${level.toLowerCase()}`]}
  aria-label={`${label}: ${level}`}
>
  <span class="label">{label}</span>
  <span class="dots" aria-hidden="true">
    {[1, 2, 3].map((dot) => <span class:list={{ filled: dot <= filled }} />)}
  </span>
  <strong>{level}</strong>
</span>

<style>
  .badge {
    --badge-color: var(--color-teal-dark);
    --badge-bg: var(--color-teal-soft);

    display: inline-flex;
    padding: var(--space-2) var(--space-3);
    align-items: center;
    border-radius: 999px;
    background: var(--badge-bg);
    color: var(--badge-color);
    font-size: var(--text-xs);
    gap: var(--space-2);
    line-height: 1;
  }

  .badge--intermediate {
    --badge-color: #875a00;
    --badge-bg: var(--color-gold-soft);
  }

  .badge--advanced {
    --badge-color: #9c3930;
    --badge-bg: var(--color-coral-soft);
  }

  .label {
    color: var(--color-ink-muted);
  }

  .dots {
    display: inline-flex;
    gap: 0.18rem;
  }

  .dots span {
    width: 0.35rem;
    height: 0.35rem;
    border: 1px solid currentcolor;
    border-radius: 50%;
  }

  .dots .filled {
    background: currentcolor;
  }
</style>
