---
export interface ReadingSection {
  id: string;
  label: string;
}

interface Props {
  sections: ReadingSection[];
  label?: string;
}

const { sections, label = "On this day" } = Astro.props;
---

<aside class="reading-nav" data-reading-nav aria-label={label}>
  <p class="nav-label">{label}</p>
  <ol>
    {
      sections.map((section, index) => (
        <li>
          <a href={`#${section.id}`} data-section-link={section.id}>
            <span class="track" aria-hidden="true">
              <span class="fill" />
            </span>
            <span class="number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span>{section.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</aside>

<script>
  const navigations =
    document.querySelectorAll<HTMLElement>("[data-reading-nav]");

  for (const navigation of navigations) {
    const links = Array.from(
      navigation.querySelectorAll<HTMLAnchorElement>("[data-section-link]"),
    );
    const sections = links
      .map((link) => document.getElementById(link.dataset.sectionLink ?? ""))
      .filter((section): section is HTMLElement => section !== null);

    const update = () => {
      const marker = window.scrollY + window.innerHeight * 0.32;
      let activeIndex = 0;

      sections.forEach((section, index) => {
        if (section.offsetTop <= marker) activeIndex = index;
      });

      links.forEach((link, index) => {
        const state =
          index < activeIndex
            ? "complete"
            : index === activeIndex
              ? "current"
              : "upcoming";
        link.dataset.state = state;
        if (state === "current") link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>

<style>
  .reading-nav {
    position: sticky;
    top: var(--space-8);
    align-self: start;
  }

  .nav-label {
    margin-bottom: var(--space-4);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    display: grid;
    min-height: 2.85rem;
    align-items: center;
    gap: var(--space-3);
    grid-template-columns: 0.22rem 1.5rem 1fr;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .track {
    position: relative;
    width: 0.2rem;
    height: 100%;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-border);
  }

  .fill {
    position: absolute;
    inset: 0;
    background: var(--color-teal);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 280ms ease;
  }

  .number {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  a[data-state="complete"] .fill,
  a[data-state="current"] .fill {
    transform: scaleY(1);
  }

  a[data-state="current"] {
    color: var(--color-navy-deep);
    font-weight: 800;
  }

  a[data-state="current"] .number,
  a[data-state="complete"] .number {
    color: var(--color-teal-dark);
  }

  @media (width <= 62rem) {
    .reading-nav {
      position: relative;
      top: auto;
      padding: var(--space-4);
      overflow-x: auto;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
    }

    .nav-label {
      margin-bottom: var(--space-2);
    }

    ol {
      display: flex;
      width: max-content;
      gap: var(--space-3);
    }

    a {
      min-height: auto;
      grid-template-columns: 1.5rem 1fr;
    }

    .track {
      display: none;
    }
  }
</style>
