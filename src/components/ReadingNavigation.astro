---
export interface ReadingSection {
  id: string;
  label: string;
}

interface Props {
  sections: ReadingSection[];
  label?: string;
}

const { sections, label = "On this page" } = Astro.props;
---

<nav class="reading-nav" data-reading-nav aria-label={label}>
  <p>{label}</p>
  <ul>
    {
      sections.map((section) => (
        <li>
          <a href={`#${section.id}`} data-section-link={section.id}>
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const navigation = document.querySelector<HTMLElement>("[data-reading-nav]");

  if (navigation) {
    const links = Array.from(
      navigation.querySelectorAll<HTMLAnchorElement>("[data-section-link]"),
    );
    const sections = links
      .map((link) => document.getElementById(link.dataset.sectionLink ?? ""))
      .filter((section): section is HTMLElement => section !== null);

    const updateCurrentSection = () => {
      const marker = window.scrollY + window.innerHeight * 0.28;
      let current = 0;
      sections.forEach((section, index) => {
        if (section.offsetTop <= marker) current = index;
      });
      links.forEach((link, index) => {
        if (index === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    updateCurrentSection();
    window.addEventListener("scroll", updateCurrentSection, { passive: true });
    window.addEventListener("resize", updateCurrentSection);
  }
</script>

<style>
  .reading-nav {
    position: sticky;
    top: 7rem;
    align-self: start;
    padding-right: var(--space-5);
    border-right: 1px solid var(--color-border);
  }

  p {
    margin-bottom: var(--space-3);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li + li {
    margin-top: var(--space-2);
  }

  a {
    display: block;
    padding-block: var(--space-1);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    line-height: 1.4;
    text-decoration: none;
  }

  a:hover,
  a[aria-current="location"] {
    color: var(--color-teal-dark);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (width <= 62rem) {
    .reading-nav {
      position: static;
      padding: 0 0 var(--space-5);
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
    }

    li + li {
      margin-top: 0;
    }
  }

  @media print {
    .reading-nav {
      display: none;
    }
  }
</style>
