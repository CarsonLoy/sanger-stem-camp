---
interface Props {
  label?: string;
  symbol?: "spark" | "dot" | "arrow";
}

const { label, symbol = "spark" } = Astro.props;
const symbols = { spark: "✦", dot: "●", arrow: "↓" };
---

<div class="divider" role="separator" aria-label={label}>
  <span class="line"></span>
  <span class="symbol" aria-hidden="true">{symbols[symbol]}</span>
  {label && <span class="label">{label}</span>}
  <span class="line"></span>
</div>

<style>
  .divider {
    display: flex;
    margin-block: clamp(var(--space-12), 8vw, var(--space-20));
    align-items: center;
    color: var(--color-teal);
    gap: var(--space-4);
  }

  .line {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, var(--color-border));
  }

  .line:last-child {
    background: linear-gradient(90deg, var(--color-border), transparent);
  }

  .symbol {
    line-height: 1;
  }

  .label {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
