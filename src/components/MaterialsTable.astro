---
export interface Material {
  item: string;
  quantity?: string;
  notes?: string;
}

interface Props {
  materials: Material[];
  caption?: string;
}

const { materials, caption = "Materials for this activity" } = Astro.props;
---

<div class="table-wrap" tabindex="0" role="region" aria-label={caption}>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Material</th>
        <th scope="col">Quantity</th>
        <th scope="col">Notes</th>
      </tr>
    </thead>
    <tbody>
      {
        materials.map((material) => (
          <tr>
            <th scope="row">{material.item}</th>
            <td>{material.quantity ?? "—"}</td>
            <td>{material.notes ?? "—"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  caption {
    padding: var(--space-5) var(--space-6);
    color: var(--color-navy-deep);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    text-align: left;
  }

  th,
  td {
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    background: var(--color-surface-soft);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  tbody th {
    color: var(--color-navy-deep);
    font-weight: 750;
  }

  tbody tr:hover {
    background: color-mix(in srgb, var(--color-teal-soft) 45%, transparent);
  }

  @media (width <= 38rem) {
    th,
    td,
    caption {
      padding-inline: var(--space-4);
    }
  }
</style>
