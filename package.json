{
  "name": "sanger-stem-camp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "npm run lint:code && npm run lint:styles && npm run lint:markdown",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "lint:markdown": "markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#dist\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "astro": "^7.0.7",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^2.1.1",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  }
}
